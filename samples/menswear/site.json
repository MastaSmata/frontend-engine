  "routes": {
    "/": {
      "title": "THEOS — Architectural Luxury Fashion",
      "description": "THEOS — A modern menswear house defined by precision, presence, and personal style.",
      "components": [
        {
          "id": "navigation.editorial-centered",
          "props": {
            "brand": "$site.brand",
            "links": "$site.nav",
            "showCart": true
          }
        },
        {
          "id": "hero.editorial-split",
          "props": {
            "eyebrow": "$site.tagline",
            "title": "$site.brand",
            "description": "$site.tagline",
            "image": "$images.heroImage",
            "imageAlt": "$site.brand",
            "buttonLabel": "$hero.cta",
            "buttonHref": "collection.html"
          }
        },
        {
          "id": "product-grid.standard",
          "props": {
            "eyebrow": "The collection",
            "title": "Featured pieces",
            "description": "$catalog.reviews",
            "cardComponent": "product-card.editorial",
            "featuredOnly": true,
            "limit": 8
          }
        },
        {
          "id": "editorial.marquee",
          "props": {
            "title": "$editorial.title",
            "description": "$editorial.text",
            "layout": "marquee",
            "limit": "$editorial.count"
          }
        },
        {
          "id": "story.editorial",
          "props": {
            "eyebrow": "$about.eyebrow",
            "title": "$about.title",
            "text": "$about.text",
            "image": "$images.aboutImage",
            "imageAlt": "$about.imageAlt",
            "linkLabel": "Discover our story",
            "linkHref": "about.html"
          }
        },
        {
          "id": "editorial.benefits",
          "props": {
            "benefits": "$benefits"
          }
        },
        {
          "id": "social-links.inline",
          "props": {
            "label": "Follow the house",
            "links": "$site.social"
          }
        },
        {
          "id": "footer.editorial",
          "props": {
            "brand": "$site.brand",
            "note": "$site.tagline",
            "links": "$site.nav",
            "email": "$site.contact.email",
            "copyright": "$site.legalName"
          }
        },
        {
          "id": "legal.disclaimer",
          "props": {
            "text": "$disclaimer.text",
            "poweredBy": "Powered by GroundAQ"
          }
        },
        {
          "id": "cart.slide-over",
          "props": {
            "title": "$cart.title",
            "checkoutLabel": "$cart.checkoutWhatsapp"
          }
        },
        { "id": "feedback.toast" }
