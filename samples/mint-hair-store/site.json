  "routes": {
    "/": {
      "title": "MintHair — Everyday, elevated",
      "description": "MintHair — premium wigs for everyday, elevated.",
      "components": [
        {
          "id": "navigation.search-categories",
          "props": {
            "brand": "$site.brand",
            "links": "$nav.links",
            "categories": "$nav.categories",
            "searchPlaceholder": "$nav.searchPlaceholder"
          }
        },
        {
          "id": "hero.editorial-split",
          "props": {
            "eyebrow": "Everyday, elevated",
            "title": "$home.heroTitle",
            "emphasis": "$home.heroEmphasis",
            "description": "$site.description",
            "image": "$home.heroSlides.0.image",
            "imageAlt": "$home.heroSlides.0.alt",
            "buttonLabel": "$labels.shopAll",
            "buttonHref": "collection.html"
          }
        },
        {
          "id": "product-grid.standard",
          "props": {
            "eyebrow": "The good hair edit",
            "title": "$home.featuredTitle",
            "description": "$home.featuredEmphasis",
            "cardComponent": "product-card.minimal",
            "limit": 6
          }
        },
        {
          "id": "story.editorial",
          "props": {
            "eyebrow": "$about.eyebrow",
            "title": "$about.manifesto",
            "text": "$about.text",
            "image": "$home.editorialImage",
            "imageAlt": "$home.editorialAlt",
            "linkLabel": "$labels.ourStory",
            "linkHref": "about.html"
          }
        },
        {
          "id": "footer.editorial",
          "props": {
            "brand": "$site.brand",
            "note": "$footer.note",
            "links": [
              {
                "label": "Shop all",
                "href": "collection.html"
              },
              {
                "label": "Our story",
                "href": "about.html"
              },
              {
                "label": "Contact",
                "href": "contact.html"
              }
            ],
            "email": "$site.email",
            "copyright": "$footer.copyright"
          }
        },
        {
          "id": "cart.slide-over",
          "props": {
            "title": "Shopping bag",
            "checkoutLabel": "$labels.checkout"
          }
        }
      ]
    },
